<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>GTI_runtimeGC</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <!-- RuntimeGC's (decompiled) source uses file-scoped namespaces + unsafe -->
    <!-- pointer detours, so it needs a recent LangVersion and net48 like upstream. -->
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <!-- Project lives inside the Guybrush102 git repo, which auto-enables -->
    <!-- SourceLink; that fails writing sourcelink.json on this drive. Off. -->
    <EnableSourceLink>false</EnableSourceLink>
    <DeterministicSourcePaths>false</DeterministicSourcePaths>
  </PropertyGroup>

  <!-- ModFiles\ is the deployable mod payload (About / Defs / Languages / Textures), -->
  <!-- not C#. Keep it out of compilation; it is copied verbatim by the Deploy target. -->
  <ItemGroup>
    <Compile Remove="ModFiles\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>T:\SteamLibrary\steamapps\common\RimWorld\RimWorldWin64_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>T:\SteamLibrary\steamapps\common\RimWorld\RimWorldWin64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>T:\SteamLibrary\steamapps\common\RimWorld\RimWorldWin64_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>T:\SteamLibrary\steamapps\common\RimWorld\RimWorldWin64_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>T:\SteamLibrary\steamapps\common\RimWorld\RimWorldWin64_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Core" />
    <!-- RuntimeGC uses manual IL detours, not Harmony, so no 0Harmony reference. -->
  </ItemGroup>

  <!-- Deploy the WHOLE mod (payload + built DLL) into the live mod folder. -->
  <PropertyGroup>
    <ModDeployDir>T:\SteamLibrary\steamapps\common\RimWorld\Mods\GTI_runtimeGC</ModDeployDir>
  </PropertyGroup>

  <Target Name="Deploy" AfterTargets="Build">
    <ItemGroup>
      <ModPayload Include="$(MSBuildProjectDirectory)\ModFiles\**\*" />
    </ItemGroup>
    <!-- Clean the previous deploy so renamed/removed files never linger. -->
    <RemoveDir Directories="$(ModDeployDir)" />
    <!-- Copy the mod payload (About / Defs / Languages / Textures), preserving structure. -->
    <Copy SourceFiles="@(ModPayload)"
          DestinationFiles="@(ModPayload->'$(ModDeployDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <!-- Copy the freshly built assembly. -->
    <MakeDir Directories="$(ModDeployDir)\Assemblies" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDeployDir)\Assemblies" />
    <!-- Enumerate exactly what was deployed (visible at default 'minimal' verbosity). -->
    <Message Importance="high" Text="=== GTI Runtime GC deployed to $(ModDeployDir) ===" />
    <Message Importance="high" Text="  payload -> ModFiles\%(ModPayload.RecursiveDir)%(ModPayload.Filename)%(ModPayload.Extension)" />
    <Message Importance="high" Text="  assembly -> Assemblies\$(TargetFileName)" />
  </Target>
</Project>
